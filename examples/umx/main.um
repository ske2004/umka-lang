import ("window.um"; "canvas.um"; "th.um"; "coll.um"; "input.um")

fn findProp(node: umx, name: str): any {
  for i, prop in node.props {
    if prop.key == name {
      return prop.value
    }
  }

  return null
}

fn ui*(object: any, p: th::Vf2 = {}): th::Vf2 {
  if nodePtr := ^umx(object); nodePtr != null {
    node := nodePtr^
    if node.tag == "row" {
      gap := ^real(findProp(node, "gap"))
      x := 0.0
      my := 0.0

      for i, child in node.children {
        sz := ui(child, {p.x+x, p.y})
        x += sz.x
        if gap != null && i != len(node.children)-1 {
          x += gap^
        }
        if my < sz.y { my = sz.y }
      }

      return {x, my}
    } else if node.tag == "col" {
      gap := ^real(findProp(node, "gap"))
      y := 0.0
      mx := 0.0

      for i, child in node.children {
        sz := ui(child, {p.x, p.y+y})
        y += sz.y
        if gap != null && i != len(node.children)-1 {
          y += gap^
        }
        if mx < sz.x { mx = sz.x }
      }

      return {mx, y}
    } else if node.tag == "screen" {
      x := real(findProp(node, "x"))
      y := real(findProp(node, "y"))

      for i, child in node.children {
        ui(child, {p.x+x, p.y+y})
      }

      return {0, 0}
    } else if (node.tag == "button") {
      node.tag = "row"
      size := ui(node, {p.x, p.y})

      onclick := fn()(findProp(node, "onclick"))
      if coll::vf2ToRect(input::getMousePos(), {p.x, p.y, size.x+10, size.y+10}) {
        canvas::drawRect(0xEEEEEEFF, {p.x, p.y, size.x+10, size.y+10})
        if input::isJustPressed(.mouse1) {
          onclick()
        }
      } else {
        canvas::drawRect(0xCCCCCCFF, {p.x, p.y, size.x+10, size.y+10})
      }

      canvas::drawRectLines(0x000000FF, {p.x, p.y, size.x+10, size.y+10})
      // force draw
      ui(node, {p.x+5, p.y+5})
      return {size.x+10, size.y+10}
    } 
  } else if text := ^str(object); text != null {
    size := canvas::textSize(text^, 2)
    canvas::drawText(text^, {p.x, p.y}, 0x000000FF, 2)
    return {size.x, size.y}
  } else {
    text := sprintf("%v", object)
    size := canvas::textSize(text, 2)
    canvas::drawText(text, {p.x, p.y}, 0x000000FF, 2)
    return {size.x, size.y}
  }

  return {}
}

fn init*() {
  logs := new(str, "")
  write := fn (value: str): fn() |logs| {
    return |logs, value| {
      logs ^= logs^+value+"\n"
    }
  }

  window::setup("UMX UI example", 800, 600)

  window::onFrame.register(|logs, write| {
    ui(
      <screen x=30.0 y=30.0>
        <col gap=10.0>
          <row gap=10.0>
            <button onclick=write("Rewinded")>Rewind</button>
            <button onclick=write("Paused")>Pause</button>
            <button onclick=write("Forwareded")>Forward</button>
          </row>
          {logs^}
        </col>
      </screen>
    )
  })
}